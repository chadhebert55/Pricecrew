# =============================================================================
# PriceCrew environment variables
# =============================================================================
# Copy this file to .env.local for development and fill in your own values.
# NEVER commit real secrets — .env.local is gitignored.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ---- Database ----
# Get from your database host (Neon, Supabase, etc.)
# For Neon: dashboard → project → Connection Details → Pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ---- Authentication (Clerk) ----
# Get from https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Frontend needs the same publishable key exposed via Vite
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- AI Assistant (Anthropic) ----
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---- Session security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# ---- Object storage ----
# STORAGE_DRIVER selects the adapter. Options:
#   auto (default) — Vercel Blob if BLOB_READ_WRITE_TOKEN is set, else Replit
#   vercel-blob    — Vercel Blob (production)
#   replit         — Replit App Storage (legacy)
#   memory         — In-memory (tests only)
STORAGE_DRIVER=auto

# Vercel Blob (auto-set by Vercel when a Blob store is linked)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Replit App Storage (only when running inside Replit)
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=replit-objstore-...
# PRIVATE_OBJECT_DIR=/replit-objstore-.../.private
# PUBLIC_OBJECT_SEARCH_PATHS=/replit-objstore-.../public

# ---- Payments (Stripe) — optional until billing goes live ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_SOLO_PRICE_ID=price_...
# STRIPE_CREW_PRICE_ID=price_...
# STRIPE_CHECKOUT_APP_URL=https://pricecrew.example.com

# ---- Cross-origin (only when frontend and API are on different hosts) ----
# API-side allowlist for browser origins. Comma-separated, no wildcards.
# ALLOWED_ORIGINS=https://app.pricecrew.com,https://staging.pricecrew.com
# Frontend build-time base URL for API calls. Leave unset for same-origin.
# VITE_API_BASE_URL=https://api.pricecrew.com

# ---- Observability (Sentry) — optional, no-op when unset ----
# API server:
# SENTRY_DSN=https://...@o000000.ingest.sentry.io/0000000
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend (build-time):
# VITE_SENTRY_DSN=https://...@o000000.ingest.sentry.io/0000000
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload (build-time, CI only):
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=pricecrew
# SENTRY_PROJECT=electrical-estimator
